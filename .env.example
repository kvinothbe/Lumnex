ANTHROPIC_API_KEY=sk-ant-...
LUMENX_ADMIN_TOKEN=lmx_...
LUMENX_BASE_URL=https://lumenx-demo.up.railway.app

VIZUARA_DATA_DIR=./data

# Public URL of the wiki-explorer (visualizer) service. Leave blank to hide the
# nav link. Locally: http://127.0.0.1:8765. On Railway: the visualizer service's
# generated domain, e.g. https://vizuara-wiki.up.railway.app
VIZUARA_WIKI_URL=

# Phase 7 router. Leave disabled until shadow-mode metrics are approved.
VIZUARA_AUTO_SEND_ENABLED=false
VIZUARA_AUTO_SEND_THRESHOLD=0.5
